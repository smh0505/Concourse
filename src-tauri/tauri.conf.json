{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concourse",
  "version": "2.4.0",
  "identifier": "com.bloppy.concourse",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Concourse",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEODJGRDg5QTVENjJDM0IKUldRN0xOYWxpZjJDclFIbHN4SHoxQnFJcHdtOG13ZGJmRExpSzQ5alFjQWVrNFRmSUl2TEc3QmYK",
      "endpoints": ["https://github.com/smh0505/Concourse/releases/latest/download/latest.json"]
    }
  }
}
